# Rust build artifacts
native/rust/target/
**/*.rs.bk

# HarmonyOS build output
**/build/
**/.cxx/
**/.hvigor/
**/oh_modules/
**/node_modules/
*.hap
*.app

# Editor / OS
.idea/
.vscode/
.DS_Store

# Signing material — private keys / keystores. NEVER commit.
signing/
**/*.p12
**/*.jks
**/*.p7b
**/*.keystore
**/*.cer
**/*.pem

# DevEco / HarmonyOS local config (per-machine, regenerated by auto-signing)
.ohos/

# Local logs / temp / debug scratch
*.log
*.b64
cur_pid.txt
_*.jpeg
_*.png
_*.jpg

# Per-machine local config / env (regenerated locally, contains machine paths)
local.properties
scripts/dev.local.env

# Local tooling (e.g. portable gh CLI) — never part of the project
tools/
